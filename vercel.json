{
  "framework": null,
  "functions": {
    "api/index.py": { "maxDuration": 60 }
  },
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.rithavo.com" }],
      "headers": { "Location": "https://rithavo.com/$1" },
      "status": 308
    },
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/profile/edit(/.*)?", "dest": "api/index.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
