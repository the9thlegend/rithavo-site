{
  "framework": null,
  "functions": {
    "api/index.py": { "maxDuration": 60 }
  },
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.rithavo.com" }],
      "headers": { "Location": "https://rithavo.com/$1" },
      "status": 308
    },
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/profile/edit(/.*)?", "dest": "api/index.py" },
    { "src": "/(?:design-lab|ritanya-handoff|tests|app|\\.claude)(?:/.*)?", "status": 404 },
    { "src": "/(?:requirements\\.txt|vercel\\.json|\\.vercelignore|\\.gitignore|\\.env(?:\\..*)?)", "status": 404 },
    { "src": "/(?:.*/)?[^/]*\\.(?:py|pyc|md|toml|cfg|ini|sql|db|sqlite)", "status": 404 },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
