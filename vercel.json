{
  "framework": null,
  "functions": {
    "api/index.py": { "maxDuration": 60 }
  },
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.rithavo.com" }],
      "headers": { "Location": "https://rithavo.com/$1" },
      "status": 308
    },
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/profile/edit(/.*)?", "dest": "api/index.py" },
    { "src": "/(.*%.*)", "dest": "api/index.py" },
    { "src": "/(?:design-lab|ritanya-handoff|tests|app|\\.claude)(?:/.*)?", "dest": "api/index.py" },
    { "src": "/((?:[^./]+/)*[^./]*)", "dest": "/$1" },
    { "src": "/((?:[^./]+/)*[^./][^/]*\\.(?:html|css|js|png|docx|ico|svg|webp|jpg|jpeg|gif|woff|woff2))", "dest": "/$1" },
    { "src": "/(CNAME|robots\\.txt|sitemap\\.xml|favicon\\.ico)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
